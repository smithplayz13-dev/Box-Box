# --- App Auth ---
API_SECRET_KEY=fallback_dev_key
ALLOWED_ORIGINS=http://localhost:5173

# --- AI Provider (pick one) ---
# Option 1: Google Gemini (legacy)
GEMINI_API_KEY=your_google_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-pro

# Option 2: OpenRouter (recommended) - works with 100+ models via one key
# Get key at https://openrouter.ai/keys
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-xxxx
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional for OpenRouter ranking:
# OPENROUTER_REFERER=http://localhost:5173
# OPENROUTER_TITLE=BoxBox F1

# Option 3: OpenAI directly
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini

# Generic OpenAI-compatible (local Ollama, Together, etc.)
# AI_PROVIDER=openai-compatible
# AI_API_KEY=your_key
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=gpt-4o-mini

# Option 4: NVIDIA NIM (hosted or self-hosted) - OpenAI-compatible
# Hosted NIM: https://build.nvidia.com -> Generate API key (nvapi-...)
# Self-hosted NIM: docker run nvcr.io/nim/... on http://localhost:9000/v1
# AI_PROVIDER=nvidia          # alias for openai-compatible with NVIDIA defaults
# NVIDIA_API_KEY=nvapi-xxxxxxxx
# AI_BASE_URL=https://integrate.api.nvidia.com/v1  # default for hosted, or http://localhost:9000/v1 for self-hosted
# AI_MODEL=meta/llama-3.1-405b-instruct  # or nvidia/llama-3.1-nemotron-70b-instruct, mistralai/mixtral-8x7b-instruct, etc.
# See catalog at https://build.nvidia.com/explore/discover
