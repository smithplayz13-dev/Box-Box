# Frontend env — set these in Vercel Project Settings > Environment Variables (do NOT commit secrets)
# Local dev uses .env.local; production uses Vercel env vars. This file is just a template.
VITE_API_URL=http://localhost:8000
VITE_API_KEY=fallback_dev_key
